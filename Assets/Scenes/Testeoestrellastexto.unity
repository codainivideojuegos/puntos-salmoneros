  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c7a277112b55f1408484931bab7fb30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Test2
  preguntas:
  - pregunta: "\xBFEn qu\xE9 categor\xEDa de bioestimulantes Aminochem es l\xEDder
      de importaciones?\n(Seleccionar 2 alternativas)"
    respuesta1: "Hidrolizados proteicos (amino\xE1cidos)"
    respuesta2: Nada
    respuesta3: Nada
    respuesta4: "\xC1cidos f\xFAlvicos/h\xFAmicos"
    boolquedefinesiesESApregunta: 1
    respuesta1Correcta: 1
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 1
    repuetanume: 4
  - pregunta: "Menciona una caracter\xEDstica incorrecta sobre nuestra materia prima"
    respuesta1: Nada
    respuesta2: "No se puede criar en aguas\nmuy fr\xEDas"
    respuesta3: Nada
    respuesta4: Nada
    boolquedefinesiesESApregunta: 0
    respuesta1Correcta: 0
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 0
    repuetanume: 2
  - pregunta: "Menciona cu\xE1l es el proceso de producci\xF3n de amino\xE1cidos
      de Aminochem"
    respuesta1: Nada
    respuesta2: Nada
    respuesta3: "Hidr\xF3lisis enzim\xE1tica"
    respuesta4: Nada
    boolquedefinesiesESApregunta: 0
    respuesta1Correcta: 0
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 0
    repuetanume: 3
  - pregunta: "\xBFCu\xE1l es una ventaja de bajo peso molecular de amino\xE1cidos
      totales?"
    respuesta1: Nada
    respuesta2: "Mayor asimilaci\xF3n foliar\npor cultivo"
    respuesta3: Nada
    respuesta4: Nada
    boolquedefinesiesESApregunta: 0
    respuesta1Correcta: 0
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 0
    repuetanume: 2
  - pregunta: "\xBFCu\xE1ntos amino\xE1cidos tienen los hidrolizados prote\xEDcos
      de Aminochem?"
    respuesta1: Nada
    respuesta2: 20
    respuesta3: Nada
    respuesta4: Nada
    boolquedefinesiesESApregunta: 0
    respuesta1Correcta: 0
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 0
    repuetanume: 2
  - pregunta: "\xBFCu\xE1l no es un valor de los componentes de nuestros productos?"
    respuesta1: "Aceleraci\xF3n de degradaci\xF3n de sustrato"
    respuesta2: Nada
    respuesta3: Nada
    respuesta4: Nada
    boolquedefinesiesESApregunta: 0
    respuesta1Correcta: 0
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 0
    repuetanume: 1
  - pregunta: "Menciona cu\xE1l no es una caracter\xEDstica de alta calidad de nuestros
      productos"
    respuesta1: Nada
    respuesta2: Nada
    respuesta3: Nada
    respuesta4: "Baja relaci\xF3n\namino\xE1cidos\nlibres/totales"
    boolquedefinesiesESApregunta: 0
    respuesta1Correcta: 0
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 0
    repuetanume: 4
  - pregunta: "Menciona cu\xE1l no es un tipo de bioestimulantes"
    respuesta1: Nada
    respuesta2: Nada
    respuesta3: Fertilizantes foliares
    respuesta4: Nada
    boolquedefinesiesESApregunta: 0
    respuesta1Correcta: 0
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 0
    repuetanume: 3
  - pregunta: "\xBFQu\xE9 enunciado est\xE1 relacionado al concepto de \"Econom\xEDa
      circular\"?"
    respuesta1: Nada
    respuesta2: "Modelo que busca reducir los residuos\nde una industria al reutilizar,
