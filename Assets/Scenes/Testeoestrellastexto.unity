  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Test2
  preguntas:
  - pregunta: "\xBFEn qu\xE9 categor\xEDa de bioestimulantes Aminochem es l\xEDder
      de importaciones?\n(Seleccionar 2 alternativas)"
    respuesta1: "Hidrolizados proteicos (amino\xE1cidos)"
    respuesta2: Nada
    respuesta3: Nada
    respuesta4: "\xC1cidos f\xFAlvicos/h\xFAmicos"
    boolquedefinesiesESApregunta: 1
    respuesta1Correcta: 1
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 1
    repuetanume: 4
  - pregunta: "Menciona una caracter\xEDstica incorrecta sobre nuestra materia prima"
    respuesta1: Nada
    respuesta2: "No se puede criar en aguas\nmuy fr\xEDas"
    respuesta3: Nada
    respuesta4: Nada
    boolquedefinesiesESApregunta: 0
    respuesta1Correcta: 0
    respuesta2Correcta: 0
    respuesta3Correcta: 0
    respuesta4Correcta: 0
